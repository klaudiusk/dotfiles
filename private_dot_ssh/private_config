# Machine-specific hosts (e.g. per-machine storage box sub-accounts)
Include ~/.ssh/config.local

Host borgserver
    HostName kalcher.one
    User borg
    IdentityFile ~/.ssh/id_borg
    IdentityAgent none

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github.pub
    IdentityAgent ~/.1password/agent.sock
    IdentitiesOnly yes

Host github-impact
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github-impact
    IdentityAgent none
    IdentitiesOnly yes

Host storagebox-admin
    HostName u675073.your-storagebox.de
    User u675073
    Port 23
    IdentityFile ~/.ssh/hetzner_storagebox_1p.pub
    IdentitiesOnly yes

Host *
    IdentityAgent ~/.1password/agent.sock
