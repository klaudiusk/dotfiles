# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

export EDITOR="/usr/bin/nvim"

# Prepend a directory to PATH unless it is already there. Nested shells
# (tmux -> nvim terminal -> Claude Code ...) re-source this file, so every
# unconditional prepend would add one duplicate entry per level.
pathadd() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

# User specific environment
pathadd "$HOME/.local/bin"
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Source global definitions
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

export ANTHROPIC_API_KEY=$([ -f ~/.anthropic/api.key ] && cat ~/.anthropic/api.key || echo "")
export VOYAGE_API_KEY=$([ -f ~/.voyageai/api.key ] && cat ~/.voyageai/api.key || echo "")
export KAGI_API_KEY=$([ -f ~/.kagi/api.key ] && cat ~/.kagi/api.key || echo "")
export TAVILY_API_KEY=$([ -f ~/.tavily/api.key ] && cat ~/.tavily/api.key || echo "")

export AZURE_OPENAI_API_KEY=$([ -f ~/.azure_openai/api.key ] && cat ~/.azure_openai/api.key || echo "")

export PYTHON_KEYRING_BACKEND=keyring.backends.SecretService.Keyring

claude-ankura() {
  PGPASSWORD=$(secret-tool lookup service postgres user impact) claude "$@"
}

# conda: initialised lazily on first use. `conda shell.bash hook` costs about
# 150 ms per shell start (most of the total) and auto_activate_base is off, so
# nothing is lost by deferring it. Running `conda init bash` again would put
# the eager block back; don't.
conda() {
    unset -f conda
    eval "$("$HOME/.local/miniconda3/bin/conda" shell.bash hook 2>/dev/null)"
    conda "$@"
}

pathadd "$HOME/.npm-global/bin"

export BUN_INSTALL="$HOME/.bun"
pathadd "$BUN_INSTALL/bin"

. "$HOME/.atuin/bin/env"

[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh
eval "$(atuin init bash)"

if [[ "$CLAUDECODE" != "1" ]]; then
    eval "$(zoxide init --cmd cd bash)"
fi

# fnm (Node version manager)
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
    pathadd "$FNM_PATH"
    # A nested shell inherits its ancestors' multishell dirs in PATH; drop them
    # so `fnm env` does not stack another one per shell level.
    if [ -n "$FNM_MULTISHELL_PATH" ]; then
        PATH=$(printf '%s' "$PATH" | awk -v RS=: -v ORS=: '!/\/fnm_multishells\//' | sed 's/:$//')
    fi
    eval "$(fnm env --use-on-cd --shell bash)"
    # --use-on-cd installs `alias cd=__fnmcd`, which shadows zoxide's cd
    # function. Keep zoxide's cd and run fnm's per-directory switch from it.
    if declare -F __zoxide_cd >/dev/null; then
        unalias cd
        __zoxide_cd() {
            \builtin cd -- "$@" && __fnm_use_if_file_found
        }
    fi
fi

# Finally drop duplicate PATH entries, keeping the first occurrence. pathadd
# prevents new duplicates, but an inherited PATH (e.g. from a long-running tmux
# server started by an older shell) may already carry some.
PATH=$(printf '%s' "$PATH" | awk -v RS=: -v ORS=: '!seen[$0]++' | sed 's/:$//')
export PATH
